# ─────────────────────────────────────────────────────────────────────────────
# Studio booking PWA — environment variables. NO real values in this file.
# Copy to .env.local for local work (gitignored). Where each group lives:
#   [frontend]  build-time variables of the static site (Vercel / Cloudflare Pages)
#   [pipeline]  the operator's shell / CI when running pnpm tenant:* scripts
#   [supabase]  Edge Function secrets: `supabase secrets set KEY=value`
# Everything marked SECRET must never be put into a VITE_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# [frontend] Supabase project URL and the PUBLISHABLE key (public by design).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# [frontend] VAPID PUBLIC key for Web Push (from `pnpm push:vapid`). Empty → the
# app honestly says reminders are not configured and offers the calendar file.
VITE_VAPID_PUBLIC_KEY=

# [pipeline + frontend build] Public site origin: canonical/OG links in studio
# shells and the links printed by tenant:publish / tenant:verify.
PUBLIC_SITE_URL=https://booking.example.com

# [pipeline] Service access for tenant:publish / tenant:verify. SECRET.
# Locally these are read from `supabase status` automatically and can stay empty.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# Legacy JWT keys also work: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# [supabase] Assistant model: any OpenAI-compatible endpoint. All three empty →
# the assistant answers from templates built on the same server data (degraded).
LLM_BASE_URL=https://api.openai.com/v1
# SECRET
LLM_API_KEY=
LLM_MODEL=
# Optional: request timeout (ms) and CORS allow-list for the assistant function.
LLM_TIMEOUT_MS=20000
ASSISTANT_ALLOWED_ORIGINS=https://booking.example.com

# [supabase] Web Push (from `pnpm push:vapid`). VAPID_PRIVATE_KEY is SECRET.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# [supabase] Shared secret between Supabase Cron (Vault: dispatch_secret) and the
# notifications-dispatch function. SECRET. Store the same value in Vault.
DISPATCH_SECRET=

# Local development only
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# PW_CHROMIUM_PATH=/path/to/chromium   (Playwright, if the bundled browser differs)
# E2E_BASE_URL=https://booking.example.com   (run Playwright against a deployed site)

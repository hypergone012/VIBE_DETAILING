{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"
    },
    "demo": {
      "default": false,
      "description": "true — образец с вымышленными данными; запуск в live запрещён",
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "description": "Подпись под иконкой на главном экране (лучше до 12 символов)"
    },
    "tagline": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "timezone": {
      "type": "string"
    },
    "currency": {
      "default": "RUB",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "locale": {
      "default": "ru-RU",
      "type": "string"
    },
    "contacts": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string"
        },
        "phoneDisplay": {
          "type": "string",
          "maxLength": 32
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "addressNote": {
          "type": "string",
          "maxLength": 300
        },
        "mapUrl": {
          "type": "string",
          "format": "uri"
        },
        "geo": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lng"
          ]
        },
        "messengerUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "phone",
        "address"
      ]
    },
    "owner": {
      "description": "Почта владельца: tenant:publish создаёт вход в кабинет",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": [
        "email"
      ]
    },
    "images": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(jpe?g|png|webp|avif)$"
        },
        "hero": {
          "type": "string",
          "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(jpe?g|png|webp|avif)$"
        },
        "heroAlt": {
          "type": "string",
          "maxLength": 160
        },
        "icon": {
          "description": "Квадратная иконка приложения; по умолчанию — логотип",
          "type": "string",
          "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(jpe?g|png|webp|avif)$"
        }
      },
      "required": [
        "logo",
        "hero"
      ]
    },
    "infoCards": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "icon": {
            "default": "sparkle",
            "type": "string",
            "enum": [
              "sparkle",
              "shield",
              "clock",
              "drop",
              "car",
              "star",
              "wrench",
              "medal",
              "coffee",
              "camera"
            ]
          }
        },
        "required": [
          "title",
          "text"
        ]
      }
    },
    "booking": {
      "default": {
        "slotStepMinutes": 30,
        "minLeadMinutes": 120,
        "horizonDays": 30,
        "cancelUntilHours": 12
      },
      "type": "object",
      "properties": {
        "slotStepMinutes": {
          "default": 30,
          "anyOf": [
            {
              "type": "number",
              "const": 10
            },
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 20
            },
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        },
        "minLeadMinutes": {
          "default": 120,
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "horizonDays": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "cancelUntilHours": {
          "default": 12,
          "type": "integer",
          "minimum": 0,
          "maximum": 168
        }
      }
    },
    "resources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "default": "box",
            "type": "string",
            "enum": [
              "box",
              "lift",
              "bay",
              "master"
            ]
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "services": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "category": {
            "type": "string",
            "maxLength": 40
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Цена в рублях"
          },
          "priceFrom": {
            "default": false,
            "description": "Показывать «от …»",
            "type": "boolean"
          },
          "duration": {
            "type": [
              "string",
              "number"
            ]
          },
          "buffer": {
            "description": "Подготовка бокса после машины",
            "type": [
              "string",
              "number"
            ]
          },
          "resources": {
            "default": "all",
            "anyOf": [
              {
                "type": "string",
                "const": "all"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                }
              }
            ]
          }
        },
        "required": [
          "key",
          "name",
          "price",
          "duration"
        ]
      }
    },
    "hours": {
      "type": "object",
      "properties": {
        "mon": {
          "type": "string"
        },
        "tue": {
          "type": "string"
        },
        "wed": {
          "type": "string"
        },
        "thu": {
          "type": "string"
        },
        "fri": {
          "type": "string"
        },
        "sat": {
          "type": "string"
        },
        "sun": {
          "type": "string"
        }
      },
      "required": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "closedDates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "note": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "date"
        ]
      }
    },
    "specialHours": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "hours": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "note": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "date",
          "hours"
        ]
      }
    },
    "works": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "image": {
            "type": "string",
            "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(jpe?g|png|webp|avif)$"
          },
          "caption": {
            "type": "string",
            "maxLength": 140
          }
        },
        "required": [
          "key",
          "image"
        ]
      }
    }
  },
  "required": [
    "slug",
    "name",
    "shortName",
    "accentColor",
    "timezone",
    "contacts",
    "images",
    "infoCards",
    "resources",
    "services",
    "hours"
  ]
}

{
  "name": "studio-booking-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build/tenant-shells.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:reset": "node scripts/supabase-local.mjs db reset",
    "db:lint": "supabase db lint --schema public,private --level warning",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:no-business-strings && pnpm test:unit && pnpm test:db",
    "tenant:new": "tsx scripts/tenant/new.ts",
    "tenant:validate": "tsx scripts/tenant/validate.ts",
    "tenant:publish": "tsx scripts/tenant/publish.ts",
    "tenant:verify": "tsx scripts/tenant/verify.ts",
    "tenant:schema": "tsx scripts/tenant/json-schema.ts",
    "seed:build": "tsx scripts/tenant/seed.ts",
    "demo:media": "tsx scripts/tenant/publish.ts graphite --skip-owner && tsx scripts/tenant/publish.ts severny-boks --skip-owner",
    "local:bootstrap": "pnpm db:start && pnpm db:reset && pnpm demo:media",
    "check:no-business-strings": "tsx scripts/check-no-business-strings.ts",
    "deploy:vercel": "vercel deploy --prebuilt --prod",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name ${CF_PAGES_PROJECT:-studio-booking}",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.6",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/postgrest-js": "2.117.3",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "liquid-gl": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "workbox-window": "^7.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.6.6",
    "@astryxdesign/cli": "0.6.6",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "openai": "7.30.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
